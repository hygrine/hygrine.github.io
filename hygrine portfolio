  });

  /* ---- hero name: split into letters, fit to one line ---- */
  var nameEl = document.getElementById("name");
  var txt = nameEl.textContent;
  nameEl.textContent = "";
  txt.split("").forEach(function (c, i) {
    var s = document.createElement("span");
    s.className = "ch"; s.style.setProperty("--i", i);
    s.setAttribute("aria-hidden", "true"); s.textContent = c;
    nameEl.appendChild(s);
  });
  var heroBox = document.getElementById("top");
  var chs = nameEl.querySelectorAll(".ch");
  function fit() {
    nameEl.style.fontSize = "100px";
    var w = nameEl.scrollWidth || 1;
    var size = Math.min(240, (100 * heroBox.clientWidth / w) * 0.99);
    nameEl.style.fontSize = size + "px";
    nameEl.style.setProperty("--W", nameEl.scrollWidth + "px");
    chs.forEach(function (c) { c.style.setProperty("--x", c.offsetLeft + "px"); });
  }
  fit();
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
  window.addEventListener("resize", fit);

  /* ---- pointer light on the grid ---- */
  var root = document.documentElement, raf = 0, mx = 0, my = 0;
  if (window.matchMedia("(pointer: fine)").matches && !reduce) {
    window.addEventListener("pointermove", function (e) {
      mx = e.clientX; my = e.clientY;
      if (raf) return;
      raf = requestAnimationFrame(function () {
        raf = 0;
        root.style.setProperty("--px", mx + "px");
        root.style.setProperty("--py", my + "px");
      });
    }, { passive: true });
  }

  /* ---- Poland time widget ---- */
  var TZ = "Europe/Warsaw";
  var ticks = document.getElementById("ticks");
  var NS = "http://www.w3.org/2000/svg";
  for (var i = 0; i < 12; i++) {
    var ln = document.createElementNS(NS, "line"), a = i * Math.PI / 6, q = i % 3 === 0;
    ln.setAttribute("x1", 50 + Math.sin(a) * (q ? 38 : 41)); ln.setAttribute("y1", 50 - Math.cos(a) * (q ? 38 : 41));
    ln.setAttribute("x2", 50 + Math.sin(a) * 44); ln.setAttribute("y2", 50 - Math.cos(a) * 44);
    ln.setAttribute("class", q ? "tick q" : "tick");
    ticks.appendChild(ln);
  }
  var digitsEl = document.getElementById("digits"), dateEl = document.getElementById("date"), zoneEl = document.getElementById("zone");
  var hH = document.getElementById("hH"), hM = document.getElementById("hM"), hS = document.getElementById("hS");
  var dtf, dateF, offF;
  try {
    dtf = new Intl.DateTimeFormat("en-GB", { timeZone: TZ, hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false });
    dateF = new Intl.DateTimeFormat("en-GB", { timeZone: TZ, weekday: "long", day: "numeric", month: "long" });
    offF = new Intl.DateTimeFormat("en-US", { timeZone: TZ, timeZoneName: "shortOffset" });
  } catch (e) {}
  var cache = { h: 0, m: 0, s: 0, t: Date.now() }, lastS = -1;
  function pad(n) { return n < 10 ? "0" + n : "" + n; }
  function refresh() {
    if (!dtf) return;
    var o = {};
    dtf.formatToParts(new Date()).forEach(function (p) { o[p.type] = p.value; });
    cache = { h: (+o.hour) % 24, m: +o.minute, s: +o.second, t: Date.now() };
    if (cache.s !== lastS) {
      lastS = cache.s;
      digitsEl.textContent = pad(cache.h) + ":" + pad(cache.m) + ":" + pad(cache.s);
      if (lastS === 0 || !dateEl.dataset.set) {
        dateEl.textContent = dateF.format(new Date()); dateEl.dataset.set = "1";
        var off = ""; offF.formatToParts(new Date()).forEach(function (p) { if (p.type === "timeZoneName") off = p.value; });
        zoneEl.textContent = "Warsaw · " + (off || "GMT+1");
      }
    }
  }
  function hands() {
    var sec = cache.s + (reduce ? 0 : Math.min(0.999, (Date.now() - cache.t) / 1000));
    var min = cache.m + sec / 60, hr = (cache.h % 12) + min / 60;
    hS.setAttribute("transform", "rotate(" + (sec * 6) + " 50 50)");
    hM.setAttribute("transform", "rotate(" + (min * 6) + " 50 50)");
    hH.setAttribute("transform", "rotate(" + (hr * 30) + " 50 50)");
  }
  refresh(); hands();
  setInterval(function () { refresh(); if (reduce) hands(); }, 250);
  if (!reduce) (function loop() { hands(); requestAnimationFrame(loop); })();

  /* ---- motion loop: cursor ring, name tilt, magnetic buttons, work cards, marquee speed ---- */
  if (!reduce) {
    var fine = window.matchMedia("(pointer: fine)").matches;
    var track = document.querySelector(".marquee .track");
    var lastY = window.scrollY, vel = 0;
    var ring, dot, cx = -100, cy = -100, tx = -100, ty = -100;
    var nrx = 0, nry = 0, ntx = 0, nty = 0;
    var cards = [];
    if (fine) {
      ring = document.createElement("div"); ring.className = "cur";
      dot = document.createElement("div"); dot.className = "cur-dot";
      document.body.appendChild(ring); document.body.appendChild(dot);
      window.addEventListener("pointermove", function (e) {
        tx = e.clientX; ty = e.clientY;
        dot.style.transform = "translate(" + tx + "px," + ty + "px)";
        ntx = (e.clientY / window.innerHeight - 0.5) * -5;
        nty = (e.clientX / window.innerWidth - 0.5) * 7;
      }, { passive: true });
      document.addEventListener("pointerover", function (e) {
        ring.classList.toggle("hot", !!(e.target.closest && e.target.closest("a, button, .card")));
      });
      document.querySelectorAll(".btn").forEach(function (b) {
        b.addEventListener("pointermove", function (e) {
          var r = b.getBoundingClientRect();
          b.style.translate = ((e.clientX - r.left - r.width / 2) * 0.22) + "px " + ((e.clientY - r.top - r.height / 2) * 0.3) + "px";
        });
        b.addEventListener("pointerleave", function () { b.style.translate = "0 0"; });
      });
      document.querySelectorAll(".card").forEach(function (el) {
        var s = { el: el, px: 0, py: 0, mx: 0, my: 0, trx: 0, tryy: 0, rx: 0, ry: 0 };
        el.addEventListener("pointerenter", function (e) {
          var r = el.getBoundingClientRect();
          s.mx = s.px = e.clientX - r.left; s.my = s.py = e.clientY - r.top;
        });
        el.addEventListener("pointermove", function (e) {
          var r = el.getBoundingClientRect();
          s.px = e.clientX - r.left; s.py = e.clientY - r.top;
          s.trx = ((s.py / r.height) - 0.5) * -5;
          s.tryy = ((s.px / r.width) - 0.5) * 7;
        });
        el.addEventListener("pointerleave", function () { s.trx = 0; s.tryy = 0; });
        cards.push(s);
      });
    }
    (function tick() {
      var y = window.scrollY, dv = Math.abs(y - lastY); lastY = y;
      vel += (dv - vel) * 0.12;
      if (track && track.getAnimations) {
        var a = track.getAnimations()[0];
        if (a) a.playbackRate = 1 + Math.min(9, vel * 0.4);
      }
      if (fine) {
        cx += (tx - cx) * 0.17; cy += (ty - cy) * 0.17;
        ring.style.transform = "translate(" + cx + "px," + cy + "px)";
        nrx += (ntx - nrx) * 0.06; nry += (nty - nry) * 0.06;
        nameEl.style.transform = "perspective(1400px) rotateX(" + nrx.toFixed(2) + "deg) rotateY(" + nry.toFixed(2) + "deg)";
        cards.forEach(function (s) {
          s.mx += (s.px - s.mx) * 0.14; s.my += (s.py - s.my) * 0.14;
          s.rx += (s.trx - s.rx) * 0.09; s.ry += (s.tryy - s.ry) * 0.09;
          var st = s.el.style;
          st.setProperty("--mx", s.mx.toFixed(1) + "px"); st.setProperty("--my", s.my.toFixed(1) + "px");
          st.setProperty("--rx", s.rx.toFixed(2) + "deg"); st.setProperty("--ry", s.ry.toFixed(2) + "deg");
        });
      }
      requestAnimationFrame(tick);
    })();
  }

  /* ---- contact ---- */
  function fillContact(id, value, emptyText) {
    var el = document.getElementById(id);
    el.textContent = "";
    if (!value) { el.className = "v empty"; el.textContent = emptyText; return; }
    var t = document.createElement("span");
    t.textContent = value;
    var b = document.createElement("button");
    b.className = "copy"; b.type = "button"; b.textContent = "Copy";
    function sel(node) { var r = document.createRange(); r.selectNodeContents(node); var s = getSelection(); s.removeAllRanges(); s.addRange(r); }
    b.addEventListener("click", function () {
      function done() { b.textContent = "Copied"; setTimeout(function () { b.textContent = "Copy"; }, 1400); }
      try { navigator.clipboard.writeText(value).then(done, function () { sel(t); }); } catch (e) { sel(t); }
    });
    el.appendChild(t); el.appendChild(b);
  }
  fillContact("vDiscord", CONTACT.discord, "Username coming soon");
  fillContact("vEmail", CONTACT.email, "Address coming soon");

  /* ---- likes ---- */
  var buttons = Array.prototype.slice.call(document.querySelectorAll(".like"));
  var remote = 0, mine = false, localLiked = false, shown = BASE, tween = 0, busy = false;
  var db = null, uid = null;
  try { localLiked = localStorage.getItem("hyg-liked") === "1"; } catch (e) {}
  function total() { return BASE + remote + (localLiked && !mine ? 1 : 0); }
  function liked() { return mine || localLiked; }
  function paint(n) {
    buttons.forEach(function (b) {
      b.querySelector(".n").textContent = n;
      b.setAttribute("aria-pressed", liked() ? "true" : "false");
    });
  }
  function render() {
    var target = total();
    cancelAnimationFrame(tween);
    if (reduce || target === shown) { shown = target; paint(shown); return; }
    var from = shown, t0 = performance.now(), d = 500;
    (function step(now) {
      var p = Math.min(1, (now - t0) / d), e = 1 - Math.pow(1 - p, 3);
      shown = Math.round(from + (target - from) * e);
      paint(shown);
      if (p < 1) tween = requestAnimationFrame(step); else { shown = target; paint(shown); }
    })(t0);
  }
  paint(shown);
  function burst(btn) {
    if (reduce || !btn.animate) return;
    for (var i = 0; i < 10; i++) {
      var s = document.createElement("i");
      s.className = "spark"; btn.appendChild(s);
      var a = (Math.PI * 2 * i) / 10 + Math.random() * 0.4, d = 34 + Math.random() * 26;
      var an = s.animate([
        { transform: "translate(0,-50%) scale(1)", opacity: 1 },
        { transform: "translate(" + Math.cos(a) * d + "px," + (Math.sin(a) * d - 8) + "px) scale(0)", opacity: 0 }
      ], { duration: 650 + Math.random() * 250, easing: "cubic-bezier(0.16,1,0.3,1)" });
      an.onfinish = (function (n) { return function () { n.remove(); }; })(s);
    }
  }
  function saveLocal(v) { localLiked = v; try { localStorage.setItem("hyg-liked", v ? "1" : "0"); } catch (e) {} }
  async function toggle(btn) {
    if (busy) return;
    busy = true;
    var willLike = !liked();
    try {
      if (willLike) {
        if (db && uid) {
          try { await db.collection("likes").doc(uid).set({ at: Date.now() }); }
          catch (e) { saveLocal(true); }
        } else { saveLocal(true); }
      } else {
        if (localLiked) saveLocal(false);
        if (mine && db && uid) { try { await db.collection("likes").doc(uid).delete(); } catch (e) {} }
      }
    } finally { busy = false; }
    if (willLike) { burst(btn); S.like(); } else { S.unlike(); }
    render();
  }
  buttons.forEach(function (b) { b.addEventListener("click", function () { toggle(b); }); });

  /* shared counter: one document per person, so nobody can like twice */
  (async function () {
    try {
      if (!window.claude || !window.claude.use) return;
      var user = await window.claude.use("user");
      db = await window.claude.use("db");
      uid = user ? await user.id() : null;
      if (!db) return;
      db.collection("likes").onSnapshot(function (snap) {
        remote = snap.size;
        mine = !!uid && snap.docs.some(function (d) { return d.id === uid; });
        if (mine && localLiked) saveLocal(false);
        render();
      }, function () {});
    } catch (e) {}
  })();
})();
</script>

</body></html>
